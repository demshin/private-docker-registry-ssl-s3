# Public domain of the registry. Its DNS A/AAAA record must point to this host,
# and ports 80/443 must be reachable from the internet for the ACME challenge.
DOMAIN=registry.example.com
# Contact email for the ACME (Let's Encrypt) account.
ACME_EMAIL=admin@example.com

# The bucket must exist before the registry starts.
S3_REGION=us-east-1
S3_BUCKET=my-registry-bucket
# Leave both empty to use an IAM instance role instead of static keys.
S3_ACCESSKEY=
S3_SECRETKEY=
# Optional: endpoint of an S3-compatible storage (RustFS, SeaweedFS, MinIO, ...),
# e.g. https://s3.internal.example.com. Leave empty for AWS S3.
S3_ENDPOINT=
# Must be true when S3_ENDPOINT is set (required by registry v3).
S3_FORCEPATHSTYLE=false
